{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/demo",
      "dest": "/demo.html"
    },
    {
      "src": "/showcase",
      "dest": "/showcase.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}